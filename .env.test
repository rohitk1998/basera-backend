PORT=4001
CORS_ORIGIN=http://localhost:3000

# Required by env.validation.ts but not a real external call for
# DB-focused tests — placeholder values, never used to reach Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-placeholder
SUPABASE_JWT_SECRET=test-jwt-secret-not-for-production-use-only

# Local Supabase (Docker) test database — started via:
#   cd ../test-db && supabase start
# Connects directly to the Postgres container, no pooler needed locally.
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=postgres
DB_SSL=false

DB_POOL_MAX=10

# FirebaseAdminProvider calls cert() unconditionally at boot (see
# env.validation.ts comment) — these must parse as non-empty strings, but
# tests exercising Firebase-backed auth flows should mock FirebaseAdminProvider
# rather than rely on this connecting to anything real.
FIREBASE_PROJECT_ID=test-project
FIREBASE_CLIENT_EMAIL=test@test-project.iam.gserviceaccount.com
