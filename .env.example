PORT=4000
CORS_ORIGIN=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=
# Use the Session Pooler host (Supabase Dashboard -> Settings -> Database ->
# Connection pooling), not the direct db.<ref>.supabase.co host — the direct
# host is IPv6-only and unreachable from many networks/sandboxes.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RESEND_API_KEY=
EMAIL_FROM="Basera <onboarding@resend.dev>"
APP_URL=http://localhost:3000

# SMTP — used only for the email-OTP send path. SMTP_FROM is the visible sender,
# e.g. "Basera <no-reply@yourdomain>"; the server must allow that address
# (Gmail rewrites it to SMTP_USER unless it is a verified "Send mail as" alias).
# Unset = "Basera <SMTP_USER>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

UNSPLASH_ACCESS_KEY=

SARVAM_API_KEY=

# Google Geocoding API key (server-side, restrict by IP) — primary "Find on map" provider; empty = OpenStreetMap only.
GOOGLE_MAPS_SERVER_KEY=

REDIS_URL=redis://localhost:6379

DB_POOL_MAX=20

# Cashfree Verification Suite (Secure ID) — sandbox keys from the Cashfree dashboard.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox

# Explore places — attractions shown on the /stays search page.
# Places are imported from Wikidata and Wikipedia, which need no key.
# YouTube Data API v3 (free key from a Google Cloud project): admin-only trek video search.
YOUTUBE_API_KEY=

# Identity + selfie provider: admin (default, admin review queue) or didit
# (Didit hosted workflow session, https://docs.didit.me; free tier covers workflow sessions).
KYC_PROVIDER=admin
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Webhook secret from the Didit console; webhook URL: <api>/api/verification/didit/webhook
DIDIT_WEBHOOK_SECRET=
# Where Didit redirects the user afterwards (optional), e.g. https://your-app/account/verification
DIDIT_CALLBACK_URL=
# Sandbox apps ONLY (e.g. Approved / Declined); leave empty otherwise.
DIDIT_SANDBOX_SCENARIO=
# Test-only override of https://verification.didit.me - leave empty.
DIDIT_BASE_URL=

# !!! TEST ONLY — NEVER ENABLE IN PRODUCTION !!!
# true = the server skips the LOCATION checks of in-app camera capture for listing
# photos and the walkthrough video (outside Himachal, accuracy, freshness, distance
# from the pin), the pin-inside-Himachal check, and the pin-vs-district/PIN agreement
# check. With this on, a Mohali pin is accepted. The camera path and the walkthrough minimum length still apply.
# The app refuses to boot with this on when NODE_ENV=production. Restart to change.
# CAPTURE_LOCATION_BYPASS=false

# TEST ONLY. Lets guests/hosts check out before the move-out date and checkout time.
# The app refuses to boot with this on when NODE_ENV=production. Restart to change.
# CHECKOUT_DATE_BYPASS=false
